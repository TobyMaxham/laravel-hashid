{
    "name": "tobymaxham/laravel-hashid",
    "description": "Hashed IDs for Laravel: hide your database IDs in URLs, route model binding, queries, validation and JSON.",
    "keywords": [
        "TobyMaxham",
        "laravel",
        "hashid",
        "hashids",
        "obfuscation",
        "route-model-binding",
        "eloquent"
    ],
    "homepage": "https://github.com/TobyMaxham/laravel-hashid",
    "license": "MIT",
    "authors": [
        {
            "name": "TobyMaxham",
            "email": "git@maxham.net",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "hashids/hashids": "^5.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "TobyMaxham\\HashId\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TobyMaxham\\HashId\\Tests\\": "tests"
        }
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.21",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0"
    },
    "suggest": {
        "ext-gmp": "Recommended for best performance with hashids/hashids.",
        "ext-bcmath": "Alternative to GMP. At least one is required."
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "TobyMaxham\\HashId\\HashIdServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test-coverage": "XDEBUG_MODE=coverage vendor/bin/pest --coverage",
        "cs-fix": "./vendor/bin/pint src/ tests/",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
